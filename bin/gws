#!/usr/bin/env bash
# gws-accounts-wrapper: gws with named accounts and credential tiers.
#
# Install ahead of the real gws on PATH. A call names its account with
# GOOGLE_WORKSPACE_CLI_CONFIG_DIR="$HOME/.config/gws/<account>" or the shorthand
# GWS_ACCOUNT=<account>; ~/.config/gws/accounts.json lists the accounts. An
# account with `tiers` runs on the credential its selected tier's command
# injects (GWS_TIER=<tier>, default `read`). An account without tiers runs on
# the login `gws auth login` stored in its directory. README.md has the contract.
set -euo pipefail

readonly ACCOUNTS_ROOT="${HOME}/.config/gws"
readonly ACCOUNTS_FILE="${ACCOUNTS_ROOT}/accounts.json"
readonly DEFAULT_TIER=read

# What a .env gws loads must never choose for it. gws loads the nearest .env
# itself and cannot be told not to, filling every variable the environment
# leaves unset, so whoever can write a .env above the working directory would
# otherwise choose where a credential-carrying call goes, what it trusts, or
# what it records.
#
# A key whose empty value turns its effect off is neutralised, not refused:
# the launch passes it empty when the caller has not set it, and gws keeps
# what the environment already holds. An ordinary project .env with a proxy
# setting then runs, instead of being refused. Measured against real gws
# 0.22.5 with each key set empty: the call reached Google in every case.
#   The proxy variables reqwest reads, as case pairs (hyper-util 0.1.20
#     matcher.rs:230-234). get_first_env takes the first name of a pair that
#     is set, even to empty (matcher.rs:323-331), so an empty HTTP_PROXY would
#     hide a caller's http_proxy. A pair is therefore handled as one: the
#     caller set one name, its value is copied to the unset twin; the caller
#     set both, both are left alone; the caller set neither, both are emptied.
#   SSLKEYLOGFILE, which rustls writes TLS session keys to when a program
#     turns its key log on (rustls 0.23.37 key_log_file.rs:88-91). gws never
#     does, so this is defence in depth.
#   XDG_CONFIG_HOME, which moves gws's legacy store when its own config dir
#     is unset (auth_commands.rs:327, dirs 5.0.1 lin.rs:9).
# Checked and left out: HOME, because the wrapper stops under set -u when it
# is unset (ACCOUNTS_ROOT below) and dotenvy never overrides a set one; TMPDIR,
# which gws 0.22.5 reads only in its tests.
readonly DOTENV_PROXY_PAIRS="HTTP_PROXY:http_proxy HTTPS_PROXY:https_proxy ALL_PROXY:all_proxy NO_PROXY:no_proxy"
readonly DOTENV_NEUTRAL_KEYS="SSLKEYLOGFILE XDG_CONFIG_HOME"

# A call is refused when the .env sets one of these and the environment does
# not, because no value of theirs is both neutral and safe:
#   SSL_CERT_FILE and SSL_CERT_DIR name the roots gws trusts, and an empty
#     value is still Some(""), so the platform store is skipped
#     (rustls-native-certs 0.8.3 lib.rs:198-208,361-362). Measured: emptying
#     either one breaks TLS, and gws fails with error[discovery].
#   REQUEST_METHOD turns proxying off entirely (matcher.rs:230,305-311), so
#     emptying it would itself cancel a proxy the caller set. Measured: with
#     HTTPS_PROXY set and REQUEST_METHOD empty, gws ignored the proxy.
#   GOOGLE_APPLICATION_CREDENTIALS, the ADC path (auth.rs:105,404). Emptying
#     it is not neutral: gws reads an empty value as an explicit path and
#     fails with "points to , but file does not exist" instead of falling
#     back to the well-known ADC file (auth.rs:404-419).
#   GOOGLE_WORKSPACE_ names every gws setting, and the wrapper, not a project,
#     chooses gws's credentials and configuration. One of them,
#     GOOGLE_WORKSPACE_CLI_SANITIZE_TEMPLATE (main.rs:192-201), makes gws POST
#     every response body, with the bearer token, to a host the value names;
#     emptying it warns on each successful call instead.
# A tier call is exempt from the ones its launch assigns (tier_launch_env).
readonly DOTENV_REFUSE_KEYS="SSL_CERT_FILE SSL_CERT_DIR REQUEST_METHOD GOOGLE_APPLICATION_CREDENTIALS"
readonly DOTENV_REFUSE_PREFIXES="GOOGLE_WORKSPACE_"

# gws auth starts gcloud as a child (setup.rs:444-447,777 through
# auth_commands.rs:782,1441), which inherits what gws loaded from .env. gcloud
# runs the interpreter CLOUDSDK_PYTHON names (google-cloud-sdk 589.0.0
# bin/gcloud:9-11,212) and takes every property from CLOUDSDK_<SECTION>_<NAME>
# (properties.py:5516), its CA bundle from REQUESTS_CA_BUNDLE or CURL_CA_BUNDLE
# (requests sessions.py:764-771), its TLS key log from SSLKEYLOGFILE (urllib3
# ssl_.py:322-327) and its metadata host from GCE_METADATA_* (google-auth
# _metadata.py:53-57,94). Being Python and sh, it also honours PYTHON*, the
# loader's LD_*/DYLD_*, OPENSSL_*, bash's BASH_ENV, SHELLOPTS and PS4, and
# TMPDIR, where Python's tempfile puts its files. Whether gcloud writes a
# credential there is unmeasured, so it is refused for an auth call too.
#
# BROWSER is a program, not a browser name: gcloud's login flow calls Python's
# webbrowser.open (flow.py:339-341 through check_browser.py:47-64), which
# gives BROWSER first place (webbrowser.py:542-552), splits a value holding %s
# into a command line (:49-55) and runs it with subprocess.Popen (:179-189).
# A project .env could otherwise run a program of its choosing as the caller,
# during gws auth setup. DISPLAY and WAYLAND_DISPLAY choose no program by
# themselves, but gcloud tries a browser at all only when one of them is set
# (check_browser.py:27,54-56), and an empty value counts as unset there, so a
# project .env must not be what supplies them. MIR_SOCKET is the third name on
# that list. GNOME_DESKTOP_SESSION_ID and KDE_FULL_SESSION pick which
# registered browser runs (webbrowser.py:434-439), and TERM admits the console
# browsers (:524-538).
# These are refused rather than neutralised, since each belongs to a program
# the wrapper does not launch and cannot measure. Only an auth call is refused
# for them, so a Python project's .env still runs every other call.
readonly DOTENV_AUTH_KEYS="REQUESTS_CA_BUNDLE CURL_CA_BUNDLE BASH_ENV SHELLOPTS PS4 NO_GCE_CHECK TMPDIR BROWSER DISPLAY WAYLAND_DISPLAY MIR_SOCKET GNOME_DESKTOP_SESSION_ID KDE_FULL_SESSION TERM"
readonly DOTENV_AUTH_PREFIXES="CLOUDSDK_ PYTHON LD_ DYLD_ OPENSSL_ GOOGLE_CLOUD_ GOOGLE_API_ GCLOUD_ GCE_METADATA_"

# jq definitions shared by every query of accounts.json. `token` turns an
# account or tier name into its part of a credential variable name; `errors`
# yields one message per problem in the file.
readonly JQ_DEFS='
def token: ascii_upcase | gsub("[^A-Z0-9]"; "_");
def desc: if (.description // "") == "" then "" else ": \(.description)" end;
def errors:
  if type != "object" then "must be a JSON object keyed by account name"
  else
    (to_entries[] | .key as $a | .value as $v
      | if ($a | test("^[^/]+$") | not) or $a == "." or $a == ".." then "account name \($a | tojson) is not a directory name"
        elif ($v | type) != "object" then "account \($a): its entry must be an object"
        elif ($v.description // "" | type) != "string" then "account \($a): description must be a string"
        elif ($v | has("tiers") | not) then empty
        elif ($v.tiers | type) != "object" or ($v.tiers | length) == 0 then "account \($a): tiers must be a non-empty object"
        else
          ($v.tiers | to_entries[] | .key as $t | .value as $tv
            | if ($t | test("^[A-Za-z0-9_-]+$") | not) then "account \($a): tier name \($t | tojson) must match [A-Za-z0-9_-]+"
              elif ($tv | type) != "object" then "account \($a), tier \($t): must be an object"
              elif (($tv | keys) - ["command", "description"]) != [] then "account \($a), tier \($t): unknown field \((($tv | keys) - ["command", "description"])[0] | tojson)"
              elif ($tv.command | type) != "array" or ($tv.command | length) == 0 or ([$tv.command[] | type] | unique) != ["string"] then "account \($a), tier \($t): command must be a non-empty array of strings"
              elif ($tv.description // "" | type) != "string" then "account \($a), tier \($t): description must be a string"
              else empty end)
        end),
    ([to_entries[] | select(.value | has("tiers")) | {name: .key, token: (.key | token)}]
      | group_by(.token)[] | select(length > 1)
      | "accounts \(map(.name | tojson) | join(" and ")) both map to \(.[0].token) in credential variable names"),
    ([to_entries[] | .key as $a | (.value.tiers // {}) | keys[] | {where: "\($a)/\(.)", key: "GWS_\($a | token)_\(. | token)_OAUTH"}]
      | group_by(.key)[] | select(length > 1)
      | "\(map(.where) | join(" and ")) both use the credential variable \(.[0].key)")
  end;
'

# What bash cannot ask the system, perl does: PERL_COMMAND runs PERL_HELPER
# with a mode and its arguments. env drops the settings that would load other
# code into perl (PERL5OPT, PERL5LIB, PERLLIB) or recode the bytes it reads
# and prints (PERLIO, PERL_UNICODE), so every path and value stays the bytes
# the system holds.
#   find DIR: dotenvy::dotenv()'s finder (find.rs:33-57), from DIR. Prints the
#     first regular file named .env, then x, from DIR up to /. Prints nothing
#     when there is none, or when stat, which fs::metadata calls, fails for a
#     candidate with any error but NotFound, which is ENOENT alone: dotenvy
#     then stops with no file loaded at all.
readonly PERL_HELPER='
use strict;
binmode STDOUT;
my $mode = shift @ARGV;
if ($mode eq "find") {
    my $dir = shift @ARGV;
    while (1) {
        (my $candidate = $dir) =~ s{/?\z}{/.env};
        if (stat $candidate) {
            if (-f _) { print "${candidate}x"; last }
        } elsif (!$!{ENOENT}) {
            last;
        }
        last if $dir eq "/";
        $dir =~ s{/[^/]*\z}{};
        $dir = "/" if $dir eq "";
    }
} else {
    die "gws-accounts: no perl helper mode $mode\n";
}
'
PERL_COMMAND=(env -u PERL5OPT -u PERL5LIB -u PERLLIB -u PERLIO -u PERL_UNICODE perl -e "$PERL_HELPER" --)

die() {
    echo "gws-accounts: $*" >&2
    exit 1
}

is_wrapper() {
    # Every copy of this wrapper carries its marker in its first bytes, so a
    # second copy on PATH (a plugin's bin/, a clone) is skipped, not exec'd.
    local head_bytes
    head_bytes="$(head -c 512 -- "$1" 2>/dev/null | tr -d '\000')" || return 1
    [[ "$head_bytes" == *gws-accounts-wrapper* ]]
}

# A gws that hands the call to the first gws on PATH re-enters this wrapper in
# the same pid: mise's shim does, when mise has no gws version for the
# directory (a relocated HOME or XDG_CONFIG_HOME hides mise's global config),
# and this wrapper is that first gws. GWS_ACCOUNTS_HANDED ("<pid> <gws>:<gws>…")
# names every gws this wrapper handed the call to in that pid, and main reads
# them into HANDED; the lookup skips each one, and any path to the same file
# (every shim of one mise), so the call reaches the gws past them or fails,
# instead of the two exec'ing each other forever.
HANDED=""

handed_back() {
    local IFS=':'
    local gws
    for gws in $HANDED; do
        [[ -n "$gws" && "$1" -ef "$gws" ]] && return 0
    done
    return 1
}

find_real_gws() {
    local candidate
    while IFS= read -r candidate; do
        is_wrapper "$candidate" && continue
        handed_back "$candidate" && continue
        printf '%s\n' "$candidate"
        return 0
    done < <(type -ap gws)
    echo "gws-accounts: the real gws is not on PATH (npm install -g @googleworkspace/cli)${HANDED:+; ${HANDED//:/, } handed the call back to this wrapper, as a mise shim does when mise has no gws version for the directory}" >&2
    return 127
}

real_command() {
    # REAL_COMMAND := real gws $1 behind env, which drops the re-entry marker
    # and every GWS_*_OAUTH variable. Every launch builds its command here, so
    # this is where the .env gws would load is checked, for subcommand $2.
    # Then neutralise what that .env could supply, by exporting in this
    # process, so no value becomes an argument (a proxy URL can carry a
    # password): a DOTENV_PROXY_PAIRS pair whose value dotenvy would keep for
    # one name gets that value in its twin, a pair it would keep for neither
    # is emptied, and each DOTENV_NEUTRAL_KEYS key it would not keep is
    # emptied.
    # sh names the pid real gws runs in as handed the call. That pid is this
    # wrapper's for an exec and a child's otherwise; sh knows its own where
    # bash 3.2 has no $BASHPID, and its exec keeps it.
    local real_gws="$1" name pair upper lower
    reject_redirecting_dotenv "${2:-}"
    snapshot_exported
    for pair in $DOTENV_PROXY_PAIRS; do
        upper="${pair%:*}" lower="${pair#*:}"
        # dotenvy_keeps, not merely "set": a value dotenvy would replace is
        # not the caller's to preserve.
        if dotenvy_keeps "$upper" && ! dotenvy_keeps "$lower"; then
            export "$lower=${!upper}"
        elif ! dotenvy_keeps "$upper" && dotenvy_keeps "$lower"; then
            export "$upper=${!lower}"
        elif ! dotenvy_keeps "$upper"; then
            export "$upper=" "$lower="
        fi
    done
    for name in $DOTENV_NEUTRAL_KEYS; do
        dotenvy_keeps "$name" || export "$name="
    done
    REAL_COMMAND=(env -u GWS_ACCOUNTS_REENTRY)
    for name in $(compgen -v); do
        case "$name" in
            GWS_*_OAUTH) REAL_COMMAND+=(-u "$name") ;;
        esac
    done
    REAL_COMMAND+=(/bin/sh -c 'GWS_ACCOUNTS_HANDED="$$ $0"; export GWS_ACCOUNTS_HANDED; exec "$@"'
        "${HANDED:+$HANDED:}$real_gws" "$real_gws")
}

exec_real() {
    local real_gws="$1"
    shift
    real_command "$real_gws" "$(first_arg "$@")"
    exec "${REAL_COMMAND[@]}" "$@"
}

# gws parses its first non-flag argument as the service (`gws --format json
# auth status` is an error), so these agree with gws about the subcommand.
first_arg() {
    local arg
    for arg in "$@"; do
        [[ "$arg" == -* ]] && continue
        printf '%s\n' "$arg"
        return 0
    done
}

auth_subcommand() {
    local arg seen=0
    for arg in "$@"; do
        [[ "$arg" == -* ]] && continue
        if (( seen == 0 )); then
            seen=1
            continue
        fi
        printf '%s\n' "$arg"
        return 0
    done
}

require_jq() {
    command -v jq >/dev/null 2>&1 && return 0
    echo "gws-accounts: jq is not on PATH" >&2
    exit 127
}

require_perl() {
    command -v perl >/dev/null 2>&1 && return 0
    echo "gws-accounts: perl is not on PATH" >&2
    exit 127
}

validate_accounts() {
    [[ -f "$ACCOUNTS_FILE" ]] || die "$ACCOUNTS_FILE not found. Create it (see the gws-accounts README), or set GOOGLE_WORKSPACE_CLI_CONFIG_DIR to a gws config directory outside it to run gws without an account."
    require_jq
    local err
    err="$(jq -r "${JQ_DEFS}"'first(errors) // empty' "$ACCOUNTS_FILE")" || die "$ACCOUNTS_FILE is not valid JSON"
    [[ -z "$err" ]] || die "$ACCOUNTS_FILE: $err"
}

list_accounts() {
    jq -r "${JQ_DEFS}"'
        to_entries[]
        | "  \(.key)\(.value | desc)",
          (if (.value | has("tiers")) then (.value.tiers | to_entries[] | "      GWS_TIER=\(.key)\(.value | desc)")
           else "      no tiers: runs on the login gws auth login stored in its directory" end)' "$ACCOUNTS_FILE"
}

list_tiers() {
    jq -r --arg account "$1" "${JQ_DEFS}"'.[$account].tiers | to_entries[] | "  GWS_TIER=\(.key)\(.value | desc)"' "$ACCOUNTS_FILE"
}

account_listed() {
    [[ "$(jq -r --arg account "$1" 'has($account)' "$ACCOUNTS_FILE")" == true ]]
}

load_account() {
    # Sets ACCOUNT_KNOWN, ACCOUNT_TOKEN, HAS_TIERS, TIER_KNOWN, TIER_TOKEN and
    # TIER_COMMAND for account $1 and tier $2 from the validated accounts file.
    ACCOUNT_KNOWN=0 ACCOUNT_TOKEN="" HAS_TIERS=0 TIER_KNOWN=0 TIER_TOKEN=""
    TIER_COMMAND=()
    local assignments
    assignments="$(jq -r --arg account "$1" --arg tier "$2" "${JQ_DEFS}"'
        if has($account) | not then "ACCOUNT_KNOWN=0"
        else .[$account] as $v
          | "ACCOUNT_KNOWN=1",
            "ACCOUNT_TOKEN=\($account | token | @sh)",
            (if ($v | has("tiers") | not) then "HAS_TIERS=0"
             elif ($v.tiers | has($tier)) then
               "HAS_TIERS=1", "TIER_KNOWN=1",
               "TIER_TOKEN=\($tier | token | @sh)",
               "TIER_COMMAND=(\($v.tiers[$tier].command | @sh))"
             else "HAS_TIERS=1", "TIER_KNOWN=0" end)
        end' "$ACCOUNTS_FILE")" || die "reading $ACCOUNTS_FILE failed"
    eval "$assignments"
}

resolve_selection() {
    # SELECTION := account (and ACCOUNT) | passthrough | none.
    local dir="${GOOGLE_WORKSPACE_CLI_CONFIG_DIR:-}" short="${GWS_ACCOUNT:-}" dir_account=""
    case "$dir" in
        "~"*) die "GOOGLE_WORKSPACE_CLI_CONFIG_DIR starts with a literal ~ ('$dir'). A quoted ~ does not expand, and gws would write under ./~ instead. Use \"\$HOME/.config/gws/<account>\"." ;;
    esac
    while [[ "$dir" == */ ]]; do
        dir="${dir%/}"
    done
    if [[ -n "$dir" && "${dir%/*}" == "$ACCOUNTS_ROOT" && -f "$ACCOUNTS_FILE" ]]; then
        validate_accounts
        if account_listed "${dir##*/}"; then
            dir_account="${dir##*/}"
        fi
    fi
    if [[ -n "$short" ]]; then
        case "$short" in
            */* | . | ..) die "GWS_ACCOUNT must be an account name from $ACCOUNTS_FILE, got '$short'" ;;
        esac
        if [[ -z "$dir" || "$dir" == "$ACCOUNTS_ROOT/$short" ]]; then
            SELECTION=account ACCOUNT="$short"
            return 0
        fi
        if [[ -n "$dir_account" ]]; then
            die "GWS_ACCOUNT=$short and GOOGLE_WORKSPACE_CLI_CONFIG_DIR=$dir name different accounts. Set only one of them."
        fi
        # GOOGLE_WORKSPACE_CLI_CONFIG_DIR names a store outside the accounts,
        # such as a throwaway store for minting a credential. It wins over an
        # exported GWS_ACCOUNT default, and no credential is injected.
        SELECTION=passthrough
        return 0
    fi
    if [[ -n "$dir_account" ]]; then
        SELECTION=account ACCOUNT="$dir_account"
    elif [[ -n "$dir" ]]; then
        SELECTION=passthrough
    else
        SELECTION=none
    fi
}

foreign_credential() {
    # FOREIGN := the first non-empty GWS_*_OAUTH variable other than $1, or "".
    local key="$1" name
    FOREIGN=""
    for name in $(compgen -v); do
        case "$name" in
            GWS_*_OAUTH) ;;
            *) continue ;;
        esac
        [[ "$name" != "$key" && -n "${!name:-}" ]] || continue
        FOREIGN="$name"
        return 0
    done
}

reject_unselected_credentials() {
    local key="$1" tier="$2"
    foreign_credential "$key"
    [[ -z "$FOREIGN" ]] || die "$FOREIGN is set, but this call selects account $ACCOUNT, tier $tier, whose credential is $key. Unset $FOREIGN: the wrapper runs the selected tier's command itself, and GWS_TIER chooses the tier."
}

dotenv_file() {
    # DOTENV := the .env gws would load, or "". gws calls dotenvy::dotenv(),
    # whose finder takes the first regular file named .env in the working
    # directory (the physical path, from getcwd), then in each parent up to /,
    # and loads nothing at all once fs::metadata fails for a candidate with any
    # error but NotFound (find.rs:33-57): a symlink loop anywhere in its path, a
    # component that is not a directory, a directory the caller may not search.
    # A file test in bash is false for each of those and for an absent file
    # alike, so perl makes the same stat call and reads its errno.
    local dir found
    DOTENV=""
    # Command substitution strips trailing newlines, and a directory name may
    # end in one, so a sentinel keeps the name exactly; cd -P would too, but
    # would also move the wrapper to the physical path. && keeps pwd's status:
    # a working directory that no longer exists has no .env for gws to load.
    dir="$(pwd -P && printf x)" || return 0
    dir="${dir%$'\nx'}"
    require_perl
    found="$("${PERL_COMMAND[@]}" find "$dir")" || die "could not look for the .env gws would load from $dir"
    [[ -z "$found" ]] || DOTENV="${found%x}"
}

utf8_valid() {
    # dotenvy keeps an inherited value only when std::env::var reads it, which
    # needs valid UTF-8 (iter.rs:34). jq replaces every invalid byte with
    # U+FFFD, so a value that comes back unchanged is the valid one. The x
    # keeps the value's own trailing newlines, which $( ) would strip.
    local decoded
    require_jq
    decoded="$(printf '%sx' "$1" | jq -Rsr . 2>/dev/null)" || return 1
    [[ "$decoded" == "${1}x" ]]
}

snapshot_exported() {
    # EXPORTED := the names in the environment real gws will inherit, between
    # spaces. Only an exported name counts: bash gives itself shell variables
    # such as PS4, SHELLOPTS and TERM that gws never sees. Taken afresh each
    # time, since a tier launch exports its six before the check runs.
    EXPORTED=" $(compgen -e | tr '\n' ' ')"
}

dotenvy_keeps() {
    # True when dotenvy would leave the caller's value for $1 alone, so the
    # .env cannot supply that key. An empty value counts; invalid UTF-8 does
    # not, because dotenvy replaces such a value from the file.
    case "$EXPORTED" in *" $1 "*) ;; *) return 1 ;; esac
    utf8_valid "${!1}"
}

dotenv_assigned_keys() {
    # Print, one per line and in order, the keys dotenvy would set from file
    # $1. It reads logical lines, not physical ones: a quoted value runs on
    # until its quote closes (iter.rs:84-179), and loading stops at the first
    # line it cannot parse (iter.rs:32-35), so text inside a value and
    # anything after a bad line set nothing. Values are parsed only as far as
    # finding the key, and never printed. The one difference left from
    # dotenvy: a value whose own parse fails (parse.rs:69) stops it, where
    # this still reports the key, which refuses more rather than less.
    jq -Rsr '
        # The codepoints Rust'"'"'s char::is_whitespace matches.
        def ws: [9,10,11,12,13,32,133,160,5760,8192,8193,8194,8195,8196,8197,
                 8198,8199,8200,8201,8202,8232,8233,8239,8287,12288];
        def lstrip: . as $c | ($c | length) as $n
            | (first(range(0; $n) | . as $i | select((ws | index($c[$i])) == null)) // $n) as $start
            | $c[$start:];
        def rstrip: . as $c
            | (last(range(0; $c | length) | . as $i | select((ws | index($c[$i])) == null)) // -1) as $end
            | $c[0:$end + 1];
        # eval_end_state (iter.rs:84-123) over one physical line.
        def eval_end($state; $cs):
            reduce range(0; $cs | length) as $i ({pos: 0, state: $state, done: false};
                if .done then .
                else .pos = $i
                    | $cs[$i] as $c
                    | if .state == "WhiteSpace" then
                        if $c == 35 then .state = "Comment" | .done = true
                        elif $c == 92 then .state = "Escape"
                        elif $c == 34 then .state = "WeakOpen"
                        elif $c == 39 then .state = "StrongOpen"
                        else .state = "Complete" end
                    elif .state == "Escape" then .state = "Complete"
                    elif .state == "Complete" then
                        if (ws | index($c)) != null and $c != 10 and $c != 13 then .state = "WhiteSpace"
                        elif $c == 92 then .state = "Escape"
                        elif $c == 34 then .state = "WeakOpen"
                        elif $c == 39 then .state = "StrongOpen"
                        else .state = "Complete" end
                    elif .state == "WeakOpen" then
                        if $c == 92 then .state = "WeakOpenEscape"
                        elif $c == 34 then .state = "Complete"
                        else .state = "WeakOpen" end
                    elif .state == "WeakOpenEscape" then .state = "WeakOpen"
                    elif .state == "StrongOpen" then
                        if $c == 92 then .state = "StrongOpenEscape"
                        elif $c == 39 then .state = "Complete"
                        else .state = "StrongOpen" end
                    else .state = "StrongOpen" end
                end);
        # parse_key (parse.rs:76-94): an ASCII letter or _, then letters,
        # digits, _ and . ; null when the first character cannot start a key.
        def take_key($cs):
            if ($cs | length) == 0 then null
            elif ($cs[0] | [.] | implode | test("^[A-Za-z_]$")) then
                ($cs | length) as $n
                | (first(range(0; $n)
                    | select(($cs[.] | [.] | implode | test("^[A-Za-z0-9_.]$")) | not)) // $n) as $i
                | {key: ($cs[0:$i] | implode), rest: $cs[$i:]}
            else null end;
        # parse_line (parse.rs:41-74): the key of an assignment, "" for a
        # blank or comment line, and null when dotenvy stops here.
        def parse_line($cs0):
            ($cs0 | rstrip | lstrip) as $cs
            | if ($cs | length) == 0 or $cs[0] == 35 then ""
            else take_key($cs) as $k
                | if $k == null then null
                else ($k.rest | lstrip) as $rest
                    | if $k.key == "export" and (($rest | length) == 0 or $rest[0] != 61) then
                        take_key($rest) as $k2
                        | if $k2 == null then null
                        else ($k2.rest | lstrip) as $r2
                            | if ($r2 | length) > 0 and $r2[0] == 61 then $k2.key else null end
                        end
                    elif ($rest | length) > 0 and $rest[0] == 61 then $k.key
                    else null end
                end
            end;
        # remove_bom (iter.rs:58-66), then the physical lines, each keeping
        # the newline the state machine reads.
        ltrimstr("\ufeff") as $text
        | ($text | split("\n")) as $raw
        | ($raw | length) as $n
        | [range(0; $n) | if . == $n - 1 then $raw[.] else $raw[.] + "\n" end]
        | map(select(. != ""))
        # QuotedLines (iter.rs:125-179): join physical lines into logical ones.
        | reduce .[] as $line ({buf: "", state: "Complete", out: []};
            (.buf + $line) as $joined
            | if (($joined | explode | lstrip | implode) | startswith("#")) then
                .out += [""] | .buf = "" | .state = "Complete"
            else (.buf | explode | length) as $bufpos
                | eval_end(.state; ($line | explode)) as $r
                | if $r.state == "Complete" then
                    .out += [$joined | sub("\r?\n$"; "")] | .buf = "" | .state = "Complete"
                elif $r.state == "Comment" then
                    .out += [$joined | explode | .[0:$bufpos + $r.pos] | implode]
                    | .buf = "" | .state = "Complete"
                else .buf = $joined | .state = $r.state end
            end)
        | .out
        # Keys, in order, stopping where dotenvy stops.
        | . as $lines
        | [range(0; $lines | length) | parse_line($lines[.] | explode)] as $parsed
        | (first(range(0; $parsed | length) | select($parsed[.] == null)) // ($parsed | length)) as $stop
        | $parsed[0:$stop] | map(select(. != "")) | .[]
    ' <"$1"
}

reject_redirecting_dotenv() {
    # Refuse when the .env gws would load sets a key the launch cannot
    # neutralise, and dotenvy would not keep the caller's value. An auth call
    # ($1 = auth), which starts gcloud, also refuses the keys that child reads.
    # The variables a tier launch assigns are set by then, and so exempt.
    # Values are never read into the wrapper.
    local all_keys="$DOTENV_REFUSE_KEYS" all_prefixes="$DOTENV_REFUSE_PREFIXES"
    local key prefix protected found=""
    snapshot_exported
    if [[ "${1:-}" == auth ]]; then
        all_keys="$all_keys $DOTENV_AUTH_KEYS"
        all_prefixes="$all_prefixes $DOTENV_AUTH_PREFIXES"
    fi
    dotenv_file
    [[ -n "$DOTENV" && -r "$DOTENV" ]] || return 0
    require_jq
    while IFS= read -r key; do
        [[ -n "$key" ]] || continue
        protected=""
        case " $all_keys " in *" $key "*) protected=yes ;; esac
        if [[ -z "$protected" ]]; then
            for prefix in $all_prefixes; do
                if [[ "$key" == "$prefix"* ]]; then protected=yes; break; fi
            done
        fi
        [[ -n "$protected" ]] || continue
        dotenvy_keeps "$key" && continue
        case " $found " in *" $key,"* | *" $key "*) continue ;; esac
        found="${found:+$found, }$key"
    done < <(dotenv_assigned_keys "$DOTENV")
    [[ -z "$found" ]] || die "$DOTENV sets $found. gws loads that file and would use it to choose where this call goes, what it trusts, or what it records. Remove those lines from $DOTENV, or run gws from a directory outside it."
}

stored_login() {
    # STORED := the first file in store $1 that gws reads a stored login from, or "".
    local name
    STORED=""
    for name in credentials.enc credentials.json; do
        if [[ -e "$1/$name" ]]; then
            STORED="$name"
            return 0
        fi
    done
}

tier_launch_env() {
    # Export what a tier launch gives gws: the access token, the credentials
    # file (also the ADC path), the store, and the OAuth client id and secret.
    export GOOGLE_WORKSPACE_CLI_TOKEN="$1" GOOGLE_APPLICATION_CREDENTIALS="$2" \
        GOOGLE_WORKSPACE_CLI_CREDENTIALS_FILE="$2" GOOGLE_WORKSPACE_CLI_CONFIG_DIR="$3" \
        GOOGLE_WORKSPACE_CLI_CLIENT_ID="$4" GOOGLE_WORKSPACE_CLI_CLIENT_SECRET="$5"
}

run_materialized() {
    # Run real gws with the selected tier credential. An authorized_user JSON
    # credential is written to a 0600 file and may use STORE for its token
    # cache. A bare token goes only through GOOGLE_WORKSPACE_CLI_TOKEN and an
    # empty private store, so no stored login or client configuration can
    # supply credentials or a quota project.
    local real_gws="$1" key="$2" store="$3" value token="" creds_file="" client_id="" client_secret="" rc=0
    local json='^[[:space:]]*[{]'
    shift 3
    value="${!key}"
    TMP_DIR="$(mktemp -d)"
    trap 'rm -rf -- "$TMP_DIR"' EXIT
    # A value whose first non-whitespace character is { is JSON, as jq reads it;
    # anything else must be one bare token with no whitespace anywhere.
    if [[ "$value" =~ $json ]]; then
        creds_file="${TMP_DIR}/credential.json"
        (umask 077 && printf '%s' "$value" >"$creds_file")
        require_jq
        client_id="$(jq -r '.client_id // empty' "$creds_file")" || die "$key is not valid JSON"
        [[ -n "$client_id" ]] || die "$key is missing a non-empty client_id"
        client_secret="$(jq -r '.client_secret // empty' "$creds_file")" || die "$key is not valid JSON"
        [[ -n "$client_secret" ]] || die "$key is missing a non-empty client_secret"
    else
        [[ -n "$value" && "$value" != *[[:space:]]* ]] ||
            die "$key is neither an authorized_user JSON credential nor a non-empty access token without whitespace"
        token="$value" store=""
    fi
    [[ -n "$store" ]] || store="${TMP_DIR}/store"
    # Credentials reach real gws through this process's environment, which it
    # inherits; arguments to env would show them in ps. Every source is
    # assigned on both routes, and one this route must not use is set empty,
    # not unset: gws loads the nearest .env in its working directory or a parent
    # for every variable left unset. An empty token is read as absent; an empty
    # credentials-file or ADC path names no file, so the quota-project lookup
    # skips it instead of falling back to the well-known ADC file. For JSON,
    # GOOGLE_APPLICATION_CREDENTIALS names the same file: without it gws bills
    # the machine ADC's quota project, and another account's ADC gives a 403
    # naming that unrelated project. Being set, they are also exempt from the
    # .env check real_command runs.
    tier_launch_env "$token" "$creds_file" "$store" "$client_id" "$client_secret"
    real_command "$real_gws" "$(first_arg "$@")"
    "${REAL_COMMAND[@]}" "$@" || rc=$?
    exit "$rc"
}

run_tier_command() {
    # Run the tier's command around this wrapper. The re-entered copy touches
    # the marker before anything else, so a command that never ran gws is told
    # apart from one that ran it and failed.
    local tier="$1"
    shift
    local self rc=0
    self="$(readlink -f "${BASH_SOURCE[0]}")"
    MARKER_DIR="$(mktemp -d)"
    trap 'rm -rf -- "$MARKER_DIR"' EXIT
    GWS_ACCOUNTS_REENTRY="${MARKER_DIR}/entered" "${TIER_COMMAND[@]}" "$self" "$@" || rc=$?
    if [[ ! -e "${MARKER_DIR}/entered" ]]; then
        if (( rc == 0 )); then
            die "the $tier tier command for $ACCOUNT exited 0 without running gws: $(printf '%q ' "${TIER_COMMAND[@]}")"
        fi
        echo "gws-accounts: the $tier tier command for $ACCOUNT failed (exit $rc) before running gws" >&2
    fi
    exit "$rc"
}

open_first_oauth_url() {
    # Opens the first OAuth URL in gws's output as soon as its line arrives,
    # since gws then waits for the callback (mawk, Ubuntu's awk, buffers its
    # input and would see the URL only after gws exits), and reads the rest,
    # so tee never writes into a closed pipe. `script` output ends lines in
    # \r, which [^[:space:]] leaves out of the URL. forward's stdout (the URL
    # it hands back on failure) stays out of gws's output; its stderr says why.
    local line rc=0 re='https://accounts\.google\.com/o/oauth2/[^[:space:]]+'
    while IFS= read -r line; do
        [[ "$line" =~ $re ]] || continue
        forward open "${BASH_REMATCH[0]}" >/dev/null || rc=$?
        (( rc == 0 )) || echo "gws-accounts: forward open failed (exit $rc); the login cannot complete through forward" >&2
        break
    done
    cat >/dev/null
}

run_auth_login_headless() {
    # `gws auth login` prints its OAuth URL instead of opening a browser, and
    # ignores $BROWSER. With no display and `forward` on PATH, run it under
    # `script` for a PTY (its scope picker needs one), tee its output, and hand
    # the first OAuth URL to `forward open`, which opens it in the laptop's
    # browser and carries the localhost callback back. Returns without doing
    # anything for any other call.
    local real_gws="$1"
    shift
    [[ "$(first_arg "$@")" == auth && "$(auth_subcommand "$@")" == login ]] || return 0
    [[ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}${MIR_SOCKET:-}" ]] || return 0
    command -v forward >/dev/null 2>&1 || return 0
    command -v script >/dev/null 2>&1 || die "script is not on PATH; it is needed to run gws auth login through forward"
    real_command "$real_gws" auth
    local -a cmd=("${REAL_COMMAND[@]}" "$@")
    if [[ "$(uname -s)" == Darwin ]]; then
        script -q /dev/null "${cmd[@]}" | tee >(open_first_oauth_url)
    else
        script -qefc "$(printf '%q ' "${cmd[@]}")" /dev/null | tee >(open_first_oauth_url)
    fi
    exit "${PIPESTATUS[0]}"
}

main() {
    local real_gws cmd handed_pid handed_list
    read -r handed_pid handed_list <<< "${GWS_ACCOUNTS_HANDED:-}" || true
    [[ "$handed_pid" != "$$" ]] || HANDED="$handed_list"
    real_gws="$(find_real_gws)"
    cmd="$(first_arg "$@")"
    # Every launch of real gws checks the .env gws would load (real_command).

    # A direct caller supplied gws credentials itself, or the call needs none:
    # `gws schema` reads public discovery documents, and a call with no
    # subcommand only prints help or the version. A tier command re-enters this
    # wrapper with its marker set; it must not bypass selection because that
    # command also inherited a gws credential setting.
    if [[ -z "${GWS_ACCOUNTS_REENTRY:-}" ]] && \
        [[ -n "${GOOGLE_WORKSPACE_CLI_TOKEN:-}" || -n "${GOOGLE_WORKSPACE_CLI_CREDENTIALS_FILE:-}" \
            || -z "$cmd" || "$cmd" == schema ]]; then
        exec_real "$real_gws" "$@"
    fi

    resolve_selection
    case "$SELECTION" in
        none)
            validate_accounts
            die "no account selected. Set GWS_ACCOUNT=<account> (or GOOGLE_WORKSPACE_CLI_CONFIG_DIR=\"\$HOME/.config/gws/<account>\"), and GWS_TIER=<tier> for a tier other than $DEFAULT_TIER. Accounts in $ACCOUNTS_FILE:
$(list_accounts)"
            ;;
        passthrough)
            [[ -z "${GWS_TIER:-}" ]] || die "GWS_TIER=$GWS_TIER needs an account from $ACCOUNTS_FILE, and GOOGLE_WORKSPACE_CLI_CONFIG_DIR=$GOOGLE_WORKSPACE_CLI_CONFIG_DIR is not one"
            run_auth_login_headless "$real_gws" "$@"
            exec_real "$real_gws" "$@"
            ;;
    esac

    validate_accounts
    local tier="${GWS_TIER:-$DEFAULT_TIER}"
    load_account "$ACCOUNT" "$tier"
    (( ACCOUNT_KNOWN )) || die "account '$ACCOUNT' is not in $ACCOUNTS_FILE. Accounts:
$(list_accounts)"
    export GOOGLE_WORKSPACE_CLI_CONFIG_DIR="${ACCOUNTS_ROOT}/${ACCOUNT}"

    if [[ "$cmd" == auth ]]; then
        [[ -z "${GWS_TIER:-}" ]] || die "gws auth manages the login stored in $GOOGLE_WORKSPACE_CLI_CONFIG_DIR; GWS_TIER does not apply to it"
        if (( HAS_TIERS )) && [[ "$(auth_subcommand "$@")" == login ]]; then
            die "$ACCOUNT gets its credentials from its tier commands, and a login stored in $GOOGLE_WORKSPACE_CLI_CONFIG_DIR would be used only when this wrapper is bypassed. Mint a tier's credential into a throwaway store instead: GOOGLE_WORKSPACE_CLI_CONFIG_DIR=\"\$(mktemp -d)\" gws auth login --scopes <scopes>, then gws auth export --unmasked (the google-workspace skill has the steps)."
        fi
        run_auth_login_headless "$real_gws" "$@"
        exec_real "$real_gws" "$@"
    fi

    if (( ! HAS_TIERS )); then
        [[ -z "${GWS_TIER:-}" ]] || die "account $ACCOUNT has no tiers; it runs on the login gws auth login stored in $GOOGLE_WORKSPACE_CLI_CONFIG_DIR. Unset GWS_TIER."
        foreign_credential ""
        [[ -z "$FOREIGN" ]] || die "$FOREIGN is set, but account $ACCOUNT has no tiers; it runs on the login gws auth login stored in $GOOGLE_WORKSPACE_CLI_CONFIG_DIR, and would ignore that credential. Unset $FOREIGN."
        stored_login "$GOOGLE_WORKSPACE_CLI_CONFIG_DIR"
        [[ -n "$STORED" ]] || die "$GOOGLE_WORKSPACE_CLI_CONFIG_DIR holds no stored login (credentials.enc or credentials.json). Account $ACCOUNT has no tiers and runs on that login; without it, real gws would fall back to Application Default Credentials and run the call as another identity. Store the login first: GWS_ACCOUNT=$(printf '%q' "$ACCOUNT") gws auth login"
        exec_real "$real_gws" "$@"
    fi

    # gws reads a stored login from either file whenever this wrapper is bypassed.
    stored_login "$GOOGLE_WORKSPACE_CLI_CONFIG_DIR"
    if [[ -n "$STORED" ]]; then
        local stored_path="${GOOGLE_WORKSPACE_CLI_CONFIG_DIR}/${STORED}"
        die "$GOOGLE_WORKSPACE_CLI_CONFIG_DIR holds a stored login ($STORED). $ACCOUNT gets its credentials from its tier commands, and real gws would use that login whenever this wrapper is bypassed. Move it aside, which keeps it: mv '$stored_path' '$stored_path.pre-gws-accounts'. Or delete it: rm '$stored_path'"
    fi

    if (( ! TIER_KNOWN )); then
        if [[ -z "${GWS_TIER:-}" ]]; then
            die "account $ACCOUNT has no $DEFAULT_TIER tier, so every call needs GWS_TIER. Tiers:
$(list_tiers "$ACCOUNT")"
        fi
        die "account $ACCOUNT has no tier '$GWS_TIER'. Tiers:
$(list_tiers "$ACCOUNT")"
    fi

    local key="GWS_${ACCOUNT_TOKEN}_${TIER_TOKEN}_OAUTH" store=""
    # The default tier keeps the account's store and its cached access token.
    # Any other tier runs on a private store: two tiers can share an OAuth
    # client, and gws would hand one tier the other's cached token.
    [[ "$tier" != "$DEFAULT_TIER" ]] || store="$GOOGLE_WORKSPACE_CLI_CONFIG_DIR"

    if [[ -n "${GWS_ACCOUNTS_REENTRY:-}" ]]; then
        : >"$GWS_ACCOUNTS_REENTRY"
        [[ -n "${!key:-}" ]] || die "the $tier tier command for $ACCOUNT ran gws without setting $key"
        run_materialized "$real_gws" "$key" "$store" "$@"
    fi
    reject_unselected_credentials "$key" "$tier"
    # Before the tier command releases a credential, check the .env as the
    # launch will see it, with the variables it assigns already set. The launch
    # checks again, in case the tier command changed the directory.
    ( tier_launch_env "" "" "$store" "" ""; reject_redirecting_dotenv "$cmd" ) || exit
    if [[ -n "${!key:-}" ]]; then
        run_materialized "$real_gws" "$key" "$store" "$@"
    fi
    run_tier_command "$tier" "$@"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
